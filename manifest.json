{
  "name": "HanziCraft Analog — Чтение",
  "short_name": "HanziReader",
  "description": "Интерактивное чтение китайских текстов с подсказками и тренажёром",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_file",
          "accept": [
            "application/json",
            "text/plain",
            "application/octet-stream",
            ".json"
          ]
        }
      ]
    }
  }
}